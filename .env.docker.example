# Contoh .env untuk Docker Compose.  cp .env.docker.example .env
# Ganti SEMUA password dengan nilai acak milik Anda sendiri.

APP_NAME="Katniss Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
FORCE_HTTPS=false

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=katniss_store
# Jangan pakai root untuk aplikasi
DB_USERNAME=katniss
DB_PASSWORD=GANTI_PASSWORD_DB
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_DB

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
UPLOAD_DISK=public

MAIL_MAILER=log

PAYMENT_DRIVER=fake
PAYMENT_WEBHOOK_SECRET=
TOPUP_DRIVER=fake
TOPUP_AUTO_PROCESS=false

# Jalankan migrasi otomatis saat container start (true/false)
RUN_MIGRATIONS=true
