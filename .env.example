# ============================================================
# Katniss Store - contoh konfigurasi lingkungan
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# JANGAN commit file .env dan JANGAN isi rahasia nyata di file ini.
# ============================================================

APP_NAME="Katniss Store"
APP_ENV=local
# Dibuat otomatis oleh: php artisan key:generate
APP_KEY=
# production: APP_DEBUG wajib false
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# production dengan HTTPS: true
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------- Database MySQL ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=katniss_store
DB_USERNAME=root
DB_PASSWORD=
# Database cloud yang wajib SSL: isi path sertifikat CA, mis. /etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=

# ---------------- Session / Cache / Queue ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# production dengan HTTPS: true
SESSION_SECURE_COOKIE=
CACHE_STORE=database
# sync = langsung dijalankan (demo). Produksi: database/redis + queue worker
QUEUE_CONNECTION=sync

# ---------------- Storage ----------------
FILESYSTEM_DISK=local
# public = disk lokal (butuh php artisan storage:link). s3 = penyimpanan S3-compatible
UPLOAD_DISK=public
UPLOAD_MAX_KB=2048

# Isi bila UPLOAD_DISK=s3 (butuh: composer require league/flysystem-aws-s3-v3 "^3.0")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------- Email ----------------
# log = email ditulis ke storage/logs/laravel.log (cukup untuk demo)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@katnissstore.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- Pembayaran & Top-up ----------------
# fake = SIMULASI. Tidak ada uang/top-up nyata yang diproses.
PAYMENT_DRIVER=fake
# Rahasia HMAC webhook (isi string acak panjang bila webhook dipakai): php -r "echo bin2hex(random_bytes(32));"
PAYMENT_WEBHOOK_SECRET=
TOPUP_DRIVER=fake
# true = top-up otomatis diproses setelah "dibayar" (khusus demo)
TOPUP_AUTO_PROCESS=false
# Pesanan belum dibayar dibatalkan otomatis setelah N jam (butuh scheduler)
ORDER_EXPIRE_HOURS=24
MIN_ORDER_TOTAL=1000
